{
  "routes": [
    { "src": "/feed", "status": 308, "headers": { "Location": "/" } },
    { "src": "/(.*)/feed", "status": 308, "headers": { "Location": "/$1" } },
    { "src": "/(.+)/", "status": 308, "headers": { "Location": "/$1" } },

    { "src": "/categoria/ups-accesorios", "status": 301, "headers": { "Location": "/categoria/ups" } },
    { "src": "/producto/300mbps-2", "status": 301, "headers": { "Location": "/producto/router-mercusys-mw302r-300mbps-2" } },

    {
      "src": "/functions/v1/(.*)",
      "dest": "https://uyqroiydexhdazxzrypd.supabase.co/functions/v1/$1"
    },

    { "handle": "filesystem" },

    { "src": "/carrito", "dest": "/index.html" },
    { "src": "/checkout", "dest": "/index.html" },
    { "src": "/auth", "dest": "/index.html" },
    { "src": "/admin(/.*)?", "dest": "/index.html" },
    { "src": "/buscar", "dest": "/index.html" },
    { "src": "/mi-cuenta", "dest": "/index.html" },
    { "src": "/contacto-digital", "dest": "/index.html" },
    { "src": "/resultado-pago", "dest": "/index.html" },
    { "src": "/ferova", "dest": "/index.html" },

    { "src": "/producto/[^/]+", "dest": "/index.html" },
    { "src": "/categoria/[^/]+", "dest": "/index.html" },
    { "src": "/blog/[^/]+", "dest": "/index.html" },

    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
